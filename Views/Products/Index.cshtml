@model aspnet_core_tutorial.Models.PaginatedList<aspnet_core_tutorial.Models.Product>

<div class="col-lg-12">
    <div class="panel panel-default">
        <div class="panel-heading">Products</div>
        <div class="panel-body">
            @if (User.IsInRole(RoleSeeder.Admin))
            {
                <a asp-controller="Products" asp-action="Create" class="btn btn-primary">New</a>
            }
            <form asp-action="Index" method="get" class="form-inline" style="display:inline-block; margin-left: 10px;">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                       class="form-control" placeholder="Search by product name" />
                <button type="submit" class="btn btn-default">Search</button>
            </form>
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Category name</th>
                        <th>Product name</th>
                        <th>Unit Price</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@(item.Category?.CategoryName ?? "-")</td>
                            <td>@Html.DisplayFor(modelItem => item.ProductName)</td>
                            <td>@Html.DisplayFor(modelItem => item.UnitPrice)</td>
                            <td>
                                @if (User.IsInRole(RoleSeeder.Admin))
                                {
                                    <div class="card-footer">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-default @(!Model.HasPreviousPage ? "disabled" : "")">Previous</a>
            <span>Page @Model.PageIndex of @Model.TotalPages</span>
            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-default @(!Model.HasNextPage ? "disabled" : "")">Next</a>
        </div>
    </div>
</div>