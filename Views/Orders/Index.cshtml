@model aspnet_core_tutorial.Models.PaginatedList<aspnet_core_tutorial.Models.Order>

<div class="col-lg-12">
    <div class="panel panel-default">
        <div class="panel-heading">Orders</div>
        <div class="panel-body">
            <a asp-controller="Orders" asp-action="Create" class="btn btn-primary">New</a>
            <form asp-action="Index" method="get" class="form-inline" style="display:inline-block; margin-left: 10px;">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                       class="form-control" placeholder="Search by customer or product name" />
                <button type="submit" class="btn btn-default">Search</button>
            </form>
            <table>
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@Html.DisplayFor(modelItem => item.Id)</td>
                            <td>@(item.Customer != null ? $"{item.Customer.LastName} {item.Customer.FirstName}" : "-")</td>
                            <td>@(item.Product?.ProductName ?? "-")</td>
                            <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                            <td>@Html.DisplayFor(modelItem => item.Total)</td>
                            <td>
                                <div class="card-footer">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex - 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-default @(!Model.HasPreviousPage ? "disabled" : "")">Previous</a>
            <span>Page @Model.PageIndex of @Model.TotalPages</span>
            <a asp-action="Index"
               asp-route-pageNumber="@(Model.PageIndex + 1)"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-default @(!Model.HasNextPage ? "disabled" : "")">Next</a>
        </div>
    </div>
</div>
