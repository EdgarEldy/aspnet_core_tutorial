# Copy this file to .env and fill in real values for local development.
# .env itself is never committed (see .gitignore); only this .example file is.

# ASP.NET Core environment used by the app service in docker-compose.
ASPNETCORE_ENVIRONMENT=Development

# PostgreSQL credentials, consumed both by the postgres service and by the
# app's connection string (docker-compose.yml interpolates these via ${VAR}).
POSTGRES_DB=aspnet_core_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=
